# ZenG Trade — production environment for docker-compose.prod.yml
# Copy to .env.production on the EC2 box and fill in real values.
# NOTE: NEXT_PUBLIC_* vars are baked into the JS bundle at *build* time
# (CI passes them as Docker build args) — changing them here does NOT
# affect an already-built image.

# Images are built on the box by the self-hosted runner — no registry needed.

# ── Kite Connect ─────────────────────────────────────────────
KITE_API_KEY=
KITE_API_SECRET=
# Server-side access token used by the relay/cron jobs
KITE_SERVER_TOKEN=

# ── Other brokers ────────────────────────────────────────────
ANGEL_API_KEY=

# ── App URLs ─────────────────────────────────────────────────
NEXTAUTH_URL=https://www.zengtrade.in
NEXT_PUBLIC_APP_URL=https://www.zengtrade.in
NEXT_PUBLIC_EC2_WS_URL=wss://ws.zengtrade.in
NEXT_PUBLIC_REALTIME_WS_URL=wss://ws.zengtrade.in
NEXT_PUBLIC_KITE_API_KEY=

# ── Relay ────────────────────────────────────────────────────
ALLOWED_ORIGINS=https://zengtrade.in,https://www.zengtrade.in

# ── Redis (Upstash) ──────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Secrets ──────────────────────────────────────────────────
# Protects /api/cron/* endpoints
CRON_SECRET=
# Protects TradingView webhook endpoint
TV_WEBHOOK_SECRET=

# ── Optional ─────────────────────────────────────────────────
ELASTICSEARCH_URL=
